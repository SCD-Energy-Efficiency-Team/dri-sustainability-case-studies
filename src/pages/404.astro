---
import Base from '../layouts/Base.astro';
import { url } from '../lib/url';
---

<Base title="Page not found" description="That page does not exist.">
  <div class="wrap section" style="text-align:center">
    <p class="eyebrow">404</p>
    <h1>That page does not exist</h1>
    <p style="color:var(--text-muted);max-width:50ch;margin:1rem auto 2rem">
      The link may be out of date, or the article may have been renamed.
    </p>
    <div class="button-row" style="justify-content:center">
      <a class="button button--primary" href={url('/case-studies')}>Browse all articles</a>
      <a class="button button--ghost" href={url('/')}>Go home</a>
    </div>
  </div>
</Base>
