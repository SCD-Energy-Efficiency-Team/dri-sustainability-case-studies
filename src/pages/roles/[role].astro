---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, plural, type Article } from '../../lib/articles';
import { ROLES, type Role } from '../../lib/taxonomy';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  // Every role gets a page, including empty ones — an empty page is a visible
  // invitation to write the first article for that audience.
  return Object.keys(ROLES).map((role) => ({
    params: { role },
    props: { articles: articles.filter((a) => a.data.roles.includes(role as Role)) },
  }));
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const role = ROLES[Astro.params.role as Role];
---

<Base title={`For ${role.label.toLowerCase()}s`} description={role.description}>
  <div class="wrap section">
    <p class="breadcrumb"><a href={url('/roles')}>Roles</a> <span aria-hidden="true">/</span> {role.label}</p>
    <div class="section__head">
      <div>
        <h1>{role.label}</h1>
        <p>{role.description}</p>
      </div>
      <span style="color:var(--text-muted);font-size:var(--step--1)">
        {plural(articles.length, 'article')}
      </span>
    </div>

    {
      articles.length > 0 ? (
        <ul class="card-grid">
          {articles.map((article) => (
            <ArticleCard article={article} />
          ))}
        </ul>
      ) : (
        <div class="no-results">
          <p><strong>Nothing here yet.</strong></p>
          <p style="margin-top:.5rem">
            No one has written for this audience so far. If this is your role,{' '}
            <a href={url('/contribute')}>you could write the first one</a>.
          </p>
        </div>
      )
    }
  </div>
</Base>
