---
import Base from '../../layouts/Base.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getArticles, plural, tally, type Article } from '../../lib/articles';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const articles = await getArticles();
  return tally(articles, (a) => a.data.tags).map(({ value }) => ({
    params: { tag: value },
    props: { articles: articles.filter((a) => a.data.tags.includes(value)) },
  }));
}

interface Props {
  articles: Article[];
}

const { articles } = Astro.props;
const { tag } = Astro.params;
---

<Base title={`#${tag}`} description={`Articles tagged ${tag}.`}>
  <div class="wrap section">
    <p class="breadcrumb"><a href={url('/tags')}>Tags</a> <span aria-hidden="true">/</span> #{tag}</p>
    <div class="section__head">
      <div>
        <h1>#{tag}</h1>
      </div>
      <span style="color:var(--text-muted);font-size:var(--step--1)">
        {plural(articles.length, 'article')}
      </span>
    </div>

    <ul class="card-grid">
      {articles.map((article) => <ArticleCard article={article} />)}
    </ul>
  </div>
</Base>
